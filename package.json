{
  "name": "notify-status",
  "version": "1.0.1",
  "description": "Cross-platform notification authorization and Do Not Disturb status for Node / Electron (macOS + Windows, NAPI-RS prebuilt)",
  "keywords": [
    "cross-platform",
    "dnd",
    "do-not-disturb",
    "electron",
    "focus-assist",
    "focus-mode",
    "macos",
    "napi",
    "napi-rs",
    "native",
    "notification",
    "notifications",
    "quiet-hours",
    "windows"
  ],
  "homepage": "https://github.com/jong-kyung/notify-status#readme",
  "bugs": {
    "url": "https://github.com/jong-kyung/notify-status/issues"
  },
  "license": "MIT",
  "author": {
    "name": "jong-kyung",
    "email": "gyoung3063413@naver.com",
    "url": "https://github.com/jong-kyung"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jong-kyung/notify-status.git"
  },
  "files": [
    "dist/",
    "binding.cjs",
    "binding.d.cts",
    "*.node",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build:native": "napi build --platform --release --no-const-enum --js binding.cjs --dts binding.d.cts",
    "build:native:debug": "napi build --platform --no-const-enum --js binding.cjs --dts binding.d.cts",
    "build:ts": "vp pack",
    "build": "pnpm run build:native && pnpm run build:ts",
    "build:debug": "pnpm run build:native:debug && pnpm run build:ts",
    "artifacts": "napi artifacts",
    "prepublishOnly": "napi prepublish -t npm",
    "release:version": "changeset version && pnpm install --no-frozen-lockfile",
    "release:publish": "changeset publish",
    "test": "vp test",
    "test:watch": "vp test watch",
    "test:types": "tsd",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "universal": "napi universal",
    "version": "napi version",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@napi-rs/cli": "^3.7.0",
    "@types/node": "^24.13.1",
    "electron": "^42.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "tsd": "^0.33.0",
    "vite-plus": "^0.1.24"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs}": "vp check --fix"
  },
  "napi": {
    "binaryName": "notify-status",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "tsd": {
    "directory": "__test__"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "packageManager": "pnpm@10.34.3"
}
