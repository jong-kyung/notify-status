{
  "name": "notify-status",
  "version": "0.0.1",
  "description": "Cross-platform notification authorization and DND status for Node",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklee/notify-status.git"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "binding.js",
    "binding.d.ts",
    "*.node",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "napi": {
    "binaryName": "notify-status",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">= 16"
  },
  "scripts": {
    "build": "napi build --platform --release --js binding.js --dts binding.d.ts",
    "build:debug": "napi build --platform --js binding.js --dts binding.d.ts",
    "artifacts": "napi artifacts",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "ava",
    "universal": "napi universal",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "ava": "^6.0.0"
  },
  "ava": {
    "extensions": ["mjs"],
    "files": ["__test__/**/*.spec.mjs"],
    "timeout": "60s",
    "workerThreads": false
  }
}
