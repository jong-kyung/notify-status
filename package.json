{
  "name": "notify-status",
  "version": "0.0.1",
  "description": "Cross-platform notification authorization and DND status for Node",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklee/notify-status.git"
  },
  "files": [
    "dist/",
    "binding.cjs",
    "binding.d.cts",
    "*.node",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build:native": "napi build --platform --release --no-const-enum --js binding.cjs --dts binding.d.cts",
    "build:native:debug": "napi build --platform --no-const-enum --js binding.cjs --dts binding.d.cts",
    "build:ts": "vp pack",
    "build": "pnpm run build:native && pnpm run build:ts",
    "build:debug": "pnpm run build:native:debug && pnpm run build:ts",
    "artifacts": "napi artifacts",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "vp test",
    "test:watch": "vp test watch",
    "test:types": "tsd",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "universal": "napi universal",
    "version": "napi version",
    "prepare": "husky"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.6.2",
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "tsd": "^0.31.2",
    "vite-plus": "^0.1.20"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs}": "vp check --fix"
  },
  "napi": {
    "binaryName": "notify-status",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "tsd": {
    "directory": "__test__"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.3"
}
